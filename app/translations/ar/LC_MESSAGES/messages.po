msgid "Your current password is incorrect."
msgstr "كلمة المرور الحالية غير صحيحة."

#: app/routes/auth.py:587
msgid "Your password was changed. Sign in again on this device."
msgstr "تم تغيير كلمة المرور. سجّل الدخول مجددًا على هذا الجهاز."

